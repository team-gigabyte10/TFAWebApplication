@model TFAWebApplication.Models.Reports.PcRegisterFilterViewModel
@{
    ViewData["Title"] = "PC Register (PBL)";
    var from = Model.FromDate.ToString("yyyy-MM-dd");
    var to = Model.ToDate.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3">
    <h3 class="fw-bold mb-3">PC Register (PBL)</h3>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label small mb-0">From Disburse Date <span class="text-danger">*</span></label>
            <input type="date" name="fromDate" value="@from" class="form-control form-control-sm" required />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0">To Disburse Date <span class="text-danger">*</span></label>
            <input type="date" name="toDate" value="@to" class="form-control form-control-sm" required />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0">Branch Name</label>
            <input type="text" name="branch" value="@(Model.Branch == "All" ? "" : Model.Branch)" placeholder="All" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0">Customer Name</label>
            <input type="text" name="customer" value="@(Model.Customer == "All" ? "" : Model.Customer)" placeholder="All" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Show</button>
            <a class="btn btn-success btn-sm" href="@Url.Action("Export", "PcRegister", new { format = "EXCEL", fromDate = from, toDate = to, branch = Model.Branch, customer = Model.Customer })">Excel</a>
            <a class="btn btn-danger btn-sm" href="@Url.Action("Export", "PcRegister", new { format = "PDF", fromDate = from, toDate = to, branch = Model.Branch, customer = Model.Customer })">PDF</a>
        </div>
    </form>

    @if (!Model.IsSuccess)
    {
        <div class="alert alert-danger">Data could not be read: @Model.ErrorMessage</div>
    }
    else
    {
        <div class="small text-muted mb-2">@Model.Items.Count record(s)</div>
        <iframe src="@Url.Action("PreviewPdf", "PcRegister", new { fromDate = from, toDate = to, branch = Model.Branch, customer = Model.Customer })"
                style="width:100%; height:75vh; border:1px solid #ccc;"></iframe>
    }
</div>

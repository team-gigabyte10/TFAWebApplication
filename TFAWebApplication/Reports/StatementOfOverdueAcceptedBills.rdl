    <DataSet Name="BranchList">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT CAST('' AS VARCHAR(50)) AS BranchID, CAST('All Branches' AS VARCHAR(200)) AS BranchName, 0 AS SortNo UNION ALL SELECT BranchID, BranchName, 1 FROM SystemManager..BankProfileBranch WITH(NOLOCK) WHERE IsDeleted = 0 ORDER BY SortNo, BranchName</CommandText>
      </Query>
      <Fields>
        <Field Name="BranchID">
          <DataField>BranchID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BranchName">
          <DataField>BranchName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CustomerList">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT CustomerID, CustomerName FROM SystemManager..CustomerProfileMaster WITH(NOLOCK) WHERE IsDeleted = 0 ORDER BY CustomerName</CommandText>
      </Query>
      <Fields>
        <Field Name="CustomerID">
          <DataField>CustomerID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CustomerName">
          <DataField>CustomerName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

          <Textbox Name="Textbox6">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>To
The Additional Commissioner
Custom Bond Commissionerate
342/1 Shegunbagicha, Dhaka.</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value />
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>This is to certify that </Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!CustomerName.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>. Address : </Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!CustomerAddress.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>. Bond License No-</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!BondNumber.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> Dt-</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!BondExpiryDate.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>. eBIN-</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!BinNumber.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> Dt-</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!BinExpiryDate.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>. Is a 100% export oriented readymade garments industry has been maintaining a current account No-</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!AccountNo.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> with us. They have executed export of readymade garments worth US$ </Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Sum(Fields!ExportBillAmount.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                      <Format>n2</Format>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> against following Export LC/Contracts and proceeds US$ </Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=Sum(Fields!RealizedAmount.Value, "DataSet1")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                      <Format>n2</Format>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> has already been realized.</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
